{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/engine/world",
      "destination": "/engine",
      "permanent": false
    },
    {
      "source": "/engine/world/",
      "destination": "/engine",
      "permanent": false
    },
    {
      "source": "/engine/world/:path*",
      "destination": "/engine",
      "permanent": false
    },
    {
      "source": "/live-systems/trades",
      "destination": "/live-systems/crew/trades/",
      "permanent": false
    },
    {
      "source": "/live-systems/trades/",
      "destination": "/live-systems/crew/trades/",
      "permanent": false
    },
    {
      "source": "/live-systems/trades/decisions",
      "destination": "/live-systems/crew/reasoning/",
      "permanent": false
    },
    {
      "source": "/live-systems/trades/decisions/",
      "destination": "/live-systems/crew/reasoning/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/enrich-world-spaces",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/school/:fly(school-[a-z0-9-]+)",
      "destination": "/live-systems/flies/school/live/index.html?fly=:fly"
    },
    {
      "source": "/school/:fly(school-[a-z0-9-]+)/",
      "destination": "/live-systems/flies/school/live/index.html?fly=:fly"
    }
  ],
  "headers": [{"source":"/games/the-cosmos/:path*","headers":[
    {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},
    {"key":"CDN-Cache-Control","value":"no-store"},
    {"key":"Vercel-CDN-Cache-Control","value":"no-store"}
  ]}],
  "buildCommand": "node tools/stamp-shared.mjs && node tools/stamp-cosmos-build.mjs",
  "outputDirectory": "."
}
