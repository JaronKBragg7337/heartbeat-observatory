{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/engine/world",
      "destination": "/engine",
      "permanent": false
    },
    {
      "source": "/engine/world/",
      "destination": "/engine",
      "permanent": false
    },
    {
      "source": "/engine/world/:path*",
      "destination": "/engine",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/enrich-world-spaces",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/school/:fly(school-[a-z0-9-]+)",
      "destination": "/live-systems/flies/school/live/index.html?fly=:fly"
    },
    {
      "source": "/school/:fly(school-[a-z0-9-]+)/",
      "destination": "/live-systems/flies/school/live/index.html?fly=:fly"
    }
  ],
  "buildCommand": "node tools/stamp-shared.mjs",
  "outputDirectory": "."
}